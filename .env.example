APP_NAME="QuakeLogic HVSR Studio"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8090
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=single
LOG_LEVEL=info

# SQLite database file. Relative paths resolve against the application root.
DB_CONNECTION=sqlite
DB_DATABASE=data/hvsr-studio.sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=1440
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# HVSR Studio
HVSR_DATA_DIR=data
HVSR_ENGINE_URL=http://127.0.0.1:8765
HVSR_ENGINE_TOKEN=
HVSR_MAX_UPLOAD_MB=2048
